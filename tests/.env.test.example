# Configuration locale des tests fonctionnels.
# Copier en .env.test et compléter. Ce fichier ne contient PAS d'URL d'API :
# la cible est déterminée par TEST_ENV et config/environments.js, afin qu'un
# fichier local ne puisse pas rediriger les tests vers la production.

# Environnement visé : test (défaut) | prod (lecture seule) | local
TEST_ENV=test

# Comptes stables de l'environnement de test
TEST_LEADER_EMAIL=e2e-leader@rallyehiver.fr
TEST_LEADER_PASSWORD=
TEST_MEMBER_EMAIL=e2e-member@rallyehiver.fr
TEST_MEMBER_PASSWORD=

# Compte du back-office
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Mot de passe attribué aux comptes jetables créés pendant un run
TEST_EPHEMERAL_PASSWORD=E2eRallye!2027

# Secret du webhook Stripe en mode test (jamais celui de production)
STRIPE_TEST_WEBHOOK_SECRET=

# Équipe de test permanente, créée par scripts/provision.js
TEST_TEAM_ID=
