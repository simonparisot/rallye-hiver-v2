# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
/frontend/build
.serverless/
*.zip

# Environment files (contain secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.test
frontend/.env.local
frontend/.env.test
frontend/.env.production.local
# Bacs à sable : configuration générée par scripts/sandbox.sh, propre à un agent
backend/.sandbox-*.yml
frontend/.env.sandbox-*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Testing
coverage/

# Temporary files
tmp/
temp/
*.tmp

# Claude Code
.claude/

# Large binary files (should be stored elsewhere)
*.pdf

# Test credentials (never commit)
tests/.env.test
# Sessions Playwright : contiennent des jetons d'authentification valides
tests/e2e/.auth/

# Artefacts d'exécution Playwright (rapports, captures, vidéos, traces)
tests/test-results/
tests/playwright-report/
tests/blob-report/
.gstack/
